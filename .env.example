# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://pruneroo:pruneroo@localhost:5434/pruneroo

# --- Source APIs ------------------------------------------------------------
REALTY_BASE_URL=https://realty.democracycraft.net/v1
ANALYTICS_BASE_URL=https://analytics.democracycraft.net/v1
TREASURY_BASE_URL=https://api.democracycraft.net/economy/api/v1
PUNISHMENTS_BASE_URL=https://punishments.democracycraft.net

# Treasury JWT from `/treasuryapi personal issue` or `/treasuryapi business issue`.
TREASURY_TOKEN=

# Analytics uses cookie-session auth. Leave both blank if `/v1/whoami` reports
# that authentication is disabled on the Plan webserver.
ANALYTICS_USERNAME=
ANALYTICS_PASSWORD=

# The eviction-reports forum requires a login; guests get 403 on both HTML and
# RSS. Copy the `xf_user` cookie from a logged-in browser (DevTools ->
# Application -> Cookies) as e.g. `xf_user=123,abcdef...`.
FORUM_EVICTION_LISTING_URL=https://www.democracycraft.net/forums/eviction-reports.62/
# Archived (previous) reports: linked on the region page, never suppressing.
FORUM_ARCHIVE_LISTING_URL=https://www.democracycraft.net/forums/archive.158/
# Plot names in reports always refer to this world; matching is scoped to it.
FORUM_REGION_WORLD=Reveille
FORUM_COOKIE=

# Thread prefixes meaning a report is finished; anything else counts as active.
# /sync lists the prefixes actually observed so this can be corrected.
# Real prefixes observed on the open listing: Pending, Auction Required,
# Auctioning, Staff Action, Payment Required, Deadline Passed, Solved.
# Only 'solved' means finished; everything else is still in progress.
EVICTION_RESOLVED_PREFIXES=solved

# --- Discord alerts ---------------------------------------------------------
# Three independent webhooks; leave one blank to disable just that alert.
#
# The FIRST run of a newly configured webhook sends nothing. It records
# everything that already qualifies as a baseline, so switching an alert on does
# not replay thousands of stored bans. Alerts start from the next new item.
# To deliberately re-announce everything, delete that channel's rows from
# notification_deliveries and its `seeded.<channel>` row from sync_watermarks.
DISCORD_WEBHOOK_PUNISHMENTS=
DISCORD_WEBHOOK_PRUNE=
DISCORD_WEBHOOK_AT_RISK=

# Balance a dormant player must exceed to be announced. Deliberately far above
# PRUNE_MIN_BALANCE, which is the floor for the /prune *list* (0 = any credit);
# alerting on every credit would be noise.
DISCORD_PRUNE_MIN_BALANCE=10000

# Embeds per message. 10 is Discord's hard cap, not a preference.
DISCORD_ITEMS_PER_MESSAGE=10
# Items announced per run, per channel. Bounds a burst; the remainder goes out
# on the next run rather than being dropped. Matters most for prune, where the
# balance backfill can qualify thousands of players in an afternoon.
DISCORD_MAX_ITEMS_PER_RUN=50

# Where this app is reachable, so alerts can link back to it. Optional, but it
# must include the scheme when set: the value becomes the `url` on every Discord
# embed, and a bare hostname is rejected at boot rather than by Discord.
APP_BASE_URL=http://localhost:3000

# --- Sync worker ------------------------------------------------------------
# Set to false to run the app without the background sync worker (useful when
# driving syncs manually via `npm run sync`).
SYNC_WORKER_ENABLED=true

# --- Insight defaults -------------------------------------------------------
# Inactivity threshold, overridable per-request in the UI. The 30-day window is
# NOT configurable: it is fixed by the upstream metric the Analytics API exposes
# (online_activity.active_playtime_30d).
INACTIVITY_THRESHOLD_HOURS=6

# --- Prune (/prune) ---------------------------------------------------------
# A player dormant this long with a balance above the floor can be pruned.
# Both are overridable per-request in the UI.
PRUNE_INACTIVITY_DAYS=90
# Exclusive floor: the rule is "balance > this", so 0 means any credit at all.
PRUNE_MIN_BALANCE=0

# Pacing for the balance backfill. Treasury has no bulk balance endpoint, so
# ~61k dormant players are priced one at a time by treasury.prune.sweep, which
# runs once a minute. 150/pass finishes in roughly seven hours while leaving the
# treasury job slot free between passes; raise it to finish sooner at the cost
# of a heavier sustained load on someone else's game server.
PRUNE_SWEEP_BATCH=150
# Players worked on at once. This does NOT raise the request rate and cannot:
# every call goes through the shared throttle, which caps treasury at 2 requests
# in flight whatever this is. It exists because awaiting each player in turn left
# most of the allowance unused. Above ~4 the throttle is the binding constraint.
PRUNE_SWEEP_CONCURRENCY=4
# Dormant balances still move (chest shops sell while the owner is offline), so
# they are re-read on this cycle by treasury.prune.balance.sweep.
PRUNE_BALANCE_BATCH=300
PRUNE_BALANCE_MAX_AGE_HOURS=24

# Rows per page on /prune. Display only — the page serves stored balances and
# makes no upstream requests, so this no longer bounds any request count.
PRUNE_PAGE_SIZE=25

# --- At-risk defaults ------------------------------------------------------
# The at-risk list opens on the slice that is actually actionable: government-
# held plots in the main world. Both are ordinary filters — the advanced panel
# can widen or clear them, and ?world=all / ?authority=all turn each off.
#
# Leave these COMMENTED OUT to accept the defaults below. Uncommenting one and
# leaving it blank is not the same thing: an empty line sets it to "", which
# overrides the default and empties the opening filter.
# DEFAULT_WORLD_UUID=b04fccfd-b696-4c85-8497-aecbb0277883   # Reveille
# DEFAULT_AUTHORITY=5aa02d16-43fb-4ac1-b4d2-a86fc986dfb2    # DCGovernment
