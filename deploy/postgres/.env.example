# Password for the `pruneroo` Postgres role. The same value goes into the
# panel's DATABASE_URL variable for the Pruneroo server.
POSTGRES_PASSWORD=

# Address the database listens on. Default is the Wings bridge gateway, which
# is reachable from server containers and from nothing else.
# docker network inspect pelican_nw -f '{{(index .IPAM.Config 0).Gateway}}'
DB_BIND_IP=172.18.0.1
