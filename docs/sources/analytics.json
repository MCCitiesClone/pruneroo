  "paths" : {
    "/auth/login" : {
      "post" : {
        "description" : "Log in as user. Pass user=username&password=password in response body.",
        "operationId" : "resolve",
        "requestBody" : {
          "content" : {
            "*/*" : {
              "example" : "user=username&password=password"
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Login success, read Set-Cookie header for cookie"
          },
          "400" : {
            "description" : "Bad input user details"
          },
          "403" : {
            "description" : "Too many attempts, wait"
          }
        }
      }
    },
    "/auth/logout" : {
      "get" : {
        "description" : "Logout the user by removing cookie",
        "operationId" : "resolve_1",
        "requestBody" : {
          "content" : {
            "*/*" : { }
          }
        },
        "responses" : {
          "302 (success)" : {
            "description" : "Logout successful, redirects to /login"
          },
          "302 (failure)" : {
            "description" : "Cookie had already expired, redirects to /login"
          }
        }
      }
    },
    "/auth/register" : {
      "get" : {
        "description" : "Start new registration and check if registration is complete. POST user=username&password=password to start new registration.",
        "operationId" : "resolve_2",
        "parameters" : [ {
          "name" : "code",
          "in" : "query",
          "description" : "Registration code for finishing registration, Check if registration is complete - success: true if yes.",
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "description" : "Register a new user",
          "content" : {
            "*/*" : {
              "example" : "user=username&password=password"
            }
          }
        },
        "responses" : {
          "200 (new)" : {
            "description" : "New registration started (when given request body details)",
            "content" : {
              "application/json" : {
                "example" : {
                  "success" : true,
                  "code" : "474AF76D5362"
                }
              }
            }
          },
          "200 (unfinished)" : {
            "description" : "Registration not yet completed (when given code as parameter)",
            "content" : {
              "application/json" : {
                "example" : {
                  "success" : false
                }
              }
            }
          },
          "200 (completed)" : {
            "description" : "Registration completed (when given code as parameter)",
            "content" : {
              "application/json" : {
                "example" : {
                  "success" : true
                }
              }
            }
          },
          "400" : {
            "description" : "Given username has already been registered",
            "content" : {
              "application/json" : {
                "example" : {
                  "status" : 400,
                  "error" : "User already exists!"
                }
              }
            }
          }
        }
      }
    },
